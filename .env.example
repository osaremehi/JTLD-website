# ══════════════════════════════════════════════════════════
# JTLD Consulting Inc — Environment Variables Template
# Copy relevant sections to server/.env and client/.env
# NEVER commit .env files to git
# ══════════════════════════════════════════════════════════

# ── Supabase (get from: supabase.com → project → Settings → API) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Frontend (Vite) — copy to client/.env ──
# VITE_ prefix required for Vite to expose to browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key
VITE_API_URL=http://localhost:3001/api

# ── Backend (Express) — copy to server/.env ──
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Production overrides ──
# VITE_API_URL=https://api.jtldinc.com/api
# CLIENT_URL=https://jtldinc.com
# NODE_ENV=production

# ── Optional: Email notifications (future) ──
# SENDGRID_API_KEY=
# EMAIL_FROM=noreply@jtldinc.com
# EMAIL_TO=info@jtldinc.com
